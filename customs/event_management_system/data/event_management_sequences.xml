<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_ems_activity" model="ir.sequence">
        <field name="name">Event Activity</field>
        <field name="code">ems.activity</field>
        <field name="prefix">ACT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_ems_incident" model="ir.sequence">
        <field name="name">Technical Incident</field>
        <field name="code">ems.incident</field>
        <field name="prefix">INC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
