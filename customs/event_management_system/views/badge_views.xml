<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_badge_list" model="ir.ui.view"><field name="name">ems.badge.list</field><field name="model">ems.badge</field><field name="arch" type="xml"><list decoration-success="status == 'issued'"><field name="badge_code"/><field name="participant_name"/><field name="event_id"/><field name="category_id"/><field name="member_id" optional="hide"/><field name="guest_id" optional="hide"/><field name="status" widget="badge"/><field name="print_count"/><field name="printed_on" optional="hide"/><field name="issued_on"/></list></field></record>
    <record id="view_ems_badge_form" model="ir.ui.view">
        <field name="name">ems.badge.form</field>
        <field name="model">ems.badge</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary" invisible="status != 'pending'"/>
                    <button name="action_print" type="object" string="Print" class="btn-primary" invisible="status not in ('generated', 'printed')"/>
                    <button name="action_reprint" type="object" string="Reprint" invisible="status not in ('printed', 'issued')"/>
                    <button name="action_issue" type="object" string="Issue" class="btn-primary" invisible="status not in ('generated', 'printed')"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,generated,printed,issued"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="badge_code"/><h1><field name="badge_code" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="category_id"/>
                            <field name="member_id" domain="[('event_id', '=', event_id)]" invisible="guest_id" required="not guest_id"/>
                            <field name="guest_id" domain="[('event_id', '=', event_id)]" invisible="member_id" required="not member_id"/>
                        </group>
                        <group>
                            <field name="registration_id" readonly="1"/>
                            <field name="participant_name" readonly="1"/>
                            <field name="print_count"/>
                            <field name="printed_on"/>
                            <field name="issued_on"/>
                        </group>
                    </group>
                    <group string="QR Code">
                        <field name="qr_image" widget="image" options="{'size': [0, 170]}" alt="Badge QR code" nolabel="1"/>
                    </group>
                    <field name="reprint_reason" placeholder="Required before reprinting"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_ems_badge_search" model="ir.ui.view"><field name="name">ems.badge.search</field><field name="model">ems.badge</field><field name="arch" type="xml"><search><field name="badge_code"/><field name="participant_name"/><field name="event_id"/><field name="category_id"/><filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/><filter name="generated" string="Generated" domain="[('status', '=', 'generated')]"/><filter name="printed" string="Printed" domain="[('status', '=', 'printed')]"/><filter name="issued" string="Issued" domain="[('status', '=', 'issued')]"/><group><filter name="group_event" string="Event" context="{'group_by': 'event_id'}"/><filter name="group_status" string="Status" context="{'group_by': 'status'}"/><filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/></group></search></field></record>
    <record id="view_ems_badge_pivot" model="ir.ui.view"><field name="name">ems.badge.pivot</field><field name="model">ems.badge</field><field name="arch" type="xml"><pivot display_quantity="1"><field name="event_id" type="row"/><field name="status" type="col"/><field name="category_id" type="col"/></pivot></field></record>
    <record id="view_ems_badge_graph" model="ir.ui.view"><field name="name">ems.badge.graph</field><field name="model">ems.badge</field><field name="arch" type="xml"><graph type="bar"><field name="event_id"/><field name="status"/></graph></field></record>
    <record id="action_ems_badge" model="ir.actions.act_window"><field name="name">Badges &amp; QR Codes</field><field name="res_model">ems.badge</field><field name="view_mode">list,form,pivot,graph</field><field name="search_view_id" ref="view_ems_badge_search"/></record>

    <record id="view_ems_badge_category_list" model="ir.ui.view"><field name="name">ems.badge.category.list</field><field name="model">ems.badge.category</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="color" widget="color_picker"/><field name="active"/></list></field></record>
    <record id="action_ems_badge_category" model="ir.actions.act_window"><field name="name">Badge Categories</field><field name="res_model">ems.badge.category</field><field name="view_mode">list</field></record>
</odoo>
