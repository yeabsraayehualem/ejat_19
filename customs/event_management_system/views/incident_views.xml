<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_incident_list" model="ir.ui.view"><field name="name">ems.incident.list</field><field name="model">ems.incident</field><field name="arch" type="xml"><list decoration-danger="priority == 'critical' and status != 'closed'" decoration-success="status == 'closed'"><field name="incident_code"/><field name="event_id"/><field name="description"/><field name="location"/><field name="priority" widget="badge" decoration-danger="priority == 'critical'"/><field name="assigned_id" widget="many2one_avatar_user"/><field name="status" widget="badge"/><field name="opened_on"/><field name="closed_on"/></list></field></record>
    <record id="view_ems_incident_form" model="ir.ui.view"><field name="name">ems.incident.form</field><field name="model">ems.incident</field><field name="arch" type="xml"><form><header><button name="action_assign" type="object" string="Assign" class="btn-primary" invisible="status != 'logged'"/><button name="action_investigate" type="object" string="Investigate" class="btn-primary" invisible="status != 'assigned'"/><button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="status != 'investigation'"/><button name="action_verify" type="object" string="Verify" class="btn-primary" invisible="status != 'resolved'"/><button name="action_close" type="object" string="Close" class="btn-primary" invisible="status != 'verified'"/><field name="status" widget="statusbar"/></header><sheet><div class="oe_title"><label for="incident_code"/><h1><field name="incident_code"/></h1></div><group><group><field name="event_id"/><field name="location"/><field name="priority"/><field name="assigned_id" widget="many2one_avatar_user"/></group><group><field name="opened_on"/><field name="closed_on"/></group></group><notebook><page string="Issue"><field name="description"/></page><page string="Resolution"><field name="resolution"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="view_ems_incident_search" model="ir.ui.view"><field name="name">ems.incident.search</field><field name="model">ems.incident</field><field name="arch" type="xml"><search><field name="incident_code"/><field name="description"/><field name="event_id"/><field name="assigned_id"/><filter name="open" string="Open" domain="[('status', '!=', 'closed')]"/><filter name="critical" string="Critical" domain="[('priority', '=', 'critical'), ('status', '!=', 'closed')]"/><filter name="mine" string="Assigned to Me" domain="[('assigned_id', '=', uid)]"/><group><filter name="group_event" string="Event" context="{'group_by': 'event_id'}"/><filter name="group_status" string="Status" context="{'group_by': 'status'}"/><filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/></group></search></field></record>
    <record id="view_ems_incident_pivot" model="ir.ui.view"><field name="name">ems.incident.pivot</field><field name="model">ems.incident</field><field name="arch" type="xml"><pivot display_quantity="1"><field name="event_id" type="row"/><field name="status" type="col"/><field name="priority" type="col"/></pivot></field></record>
    <record id="view_ems_incident_graph" model="ir.ui.view"><field name="name">ems.incident.graph</field><field name="model">ems.incident</field><field name="arch" type="xml"><graph type="bar"><field name="event_id"/><field name="status"/></graph></field></record>
    <record id="action_ems_incident" model="ir.actions.act_window"><field name="name">Technical Incidents</field><field name="res_model">ems.incident</field><field name="view_mode">list,form,pivot,graph</field><field name="search_view_id" ref="view_ems_incident_search"/></record>
</odoo>
